{
  "name": "@dev.icons/react",
  "version": "1.2.0",
  "description": "Devicons React - The React package for Devicons",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorillaz/devicons.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/vorillaz/devicons/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/vorillaz/devicons/issues"
  },
  "license": "MIT",
  "author": "Theodore Vorillas",
  "keywords": [
    "icons",
    "devicons",
    "react",
    "svg",
    "components"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mono": {
      "import": {
        "types": "./dist/mono.d.mts",
        "default": "./dist/mono.mjs"
      },
      "require": {
        "types": "./dist/mono.d.cts",
        "default": "./dist/mono.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "tsx scripts/build.ts",
    "build": "tsx scripts/build.ts && pnpm run bundle",
    "bundle": "vite build && tsx scripts/post-build.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">= 16.8",
    "react-dom": ">= 16.8"
  },
  "devDependencies": {
    "@dev.icons/codegen": "workspace:*",
    "@dev.icons/utils": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "fast-glob": "3.3.3",
    "happy-dom": "^17.4.7",
    "prettier": "3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.3"
  }
}
