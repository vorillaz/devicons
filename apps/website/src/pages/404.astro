---
import PageLayout from '../components/layout/page-layout.astro';
import GeometricGrid from '../components/layout/geometric-grid.astro';

const TRACE = [
  'GET /lost-and-found',
  'resolver → content/**/*.mdx',
  'match   → 0',
  'status  → 404 NOT FOUND',
];
---

<PageLayout
  title="404 — Page Not Found"
  description="The route you asked for isn't part of the Devicons catalog."
  image="/og/404.png"
  noindex>
  <section class="notfound relative overflow-hidden">
    <GeometricGrid />

    <div class="relative z-10 max-w-[1400px] mx-auto px-4 sm:px-6 pt-14">
      <p class="type-label mb-6 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        Error / 404 / Not Found
      </p>

      <div
        class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_420px] gap-10 lg:gap-16 items-start">
        {/* Big numerals */}
        <div class="min-w-0">
          <h1
            class="notfound-numerals type-display text-accent select-none"
            aria-label="Error 404">
            <span class="notfound-digit">4</span><span
              class="notfound-digit notfound-digit--spin"
              aria-hidden="true">0</span
            ><span class="notfound-digit">4</span>
          </h1>

          <p class="type-display-sm mt-4 md:mt-6 max-w-[18ch]">
            This route did not ship.
          </p>

          <p class="type-body-lg text-text-secondary max-w-[54ch] mt-5 md:mt-6">
            You followed a link into the void. The page you asked for
            isn&rsquo;t in the manifest &mdash; it was renamed, unpublished, or
            never existed. No icons were harmed.
          </p>

          <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-3">
            <a href="/" class="btn btn--primary btn--mono px-8"> &larr; Home </a>
            <a href="/docs/" class="btn btn--ghost btn--mono"> Read the docs </a>
            <a href="/icons/" class="btn btn--subtle btn--mono">
              Browse icons
            </a>
          </div>
        </div>

        {/* Terminal card */}
        <aside
          class="notfound-card border border-border bg-surface p-5 md:p-6"
          aria-hidden="true">
          <div
            class="flex items-center justify-between pb-3 mb-4 border-b border-border">
            <span class="type-label">trace.log</span>
            <span class="type-mono text-text-muted text-xs">devicons@1.8</span>
          </div>

          <ul class="flex flex-col gap-2 type-mono text-sm">
            {
              TRACE.map(line => (
                <li class="flex items-start gap-3">
                  <span
                    aria-hidden="true"
                    class="text-accent shrink-0 select-none">
                    $
                  </span>
                  <span class="text-text-secondary break-all">{line}</span>
                </li>
              ))
            }
            <li class="flex items-start gap-3 pt-2 mt-2 border-t border-border">
              <span
                aria-hidden="true"
                class="text-destructive shrink-0 select-none">
                !
              </span>
              <span class="text-text">
                nothing to render &mdash; redirect the user.
              </span>
            </li>
          </ul>

          <div
            class="mt-5 pt-4 border-t border-border flex items-center gap-3 type-mono text-xs text-text-muted">
            <span class="inline-block w-2 h-2 bg-destructive"></span>
            <span>connection closed</span>
            <span class="ml-auto tabular-nums">exit 404</span>
          </div>
        </aside>
      </div>

      {/* Big marquee-style footer */}
      <div
        class="notfound-strip mt-16 md:mt-24 border-y border-border overflow-hidden">
        <div class="notfound-strip__track type-mono text-text-muted">
          {
            Array.from({ length: 6 }).map(() => (
              <span class="notfound-strip__cell">
                404 / NOT_FOUND / THIS_IS_NOT_THE_ICON_YOU_ARE_LOOKING_FOR /
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .notfound {
    min-height: calc(100dvh - 56px);
  }

  /* Monolithic 404. Slab-weight numerals with a hard drop-shadow in
     the accent color — brutalist, flat, no gradients. The middle 0
     becomes a rotated square — it's a "zero" and a dropped pin. */
  .notfound-numerals {
    display: flex;
    gap: 0.04em;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }
  .notfound-digit {
    display: inline-block;
  }
  .notfound-digit--spin {
    position: relative;
    animation: notfoundSpin 12s linear infinite;
    transform-origin: 50% 55%;
  }

  @keyframes notfoundSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .notfound-card {
    position: relative;
    box-shadow: 8px 8px 0 0 var(--c-border);
    transition: border-color 0.15s ease;
  }
  .notfound-card:hover {
    border-color: var(--c-accent);
  }
  :global([data-theme='light']) .notfound-card {
    box-shadow: 8px 8px 0 0 var(--c-accent);
  }

  .notfound-strip {
    position: relative;
  }
  .notfound-strip::before,
  .notfound-strip::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    z-index: 1;
    pointer-events: none;
  }
  .notfound-strip::before {
    left: 0;
    background: linear-gradient(90deg, var(--c-bg), transparent);
  }
  .notfound-strip::after {
    right: 0;
    background: linear-gradient(270deg, var(--c-bg), transparent);
  }

  .notfound-strip__track {
    display: flex;
    gap: 2rem;
    white-space: nowrap;
    padding: 0.75rem 0;
    animation: scroll-infinite 32s linear infinite;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .notfound-strip__cell {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound-digit--spin,
    .notfound-strip__track {
      animation: none;
    }
  }
</style>
