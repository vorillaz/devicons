---
import PageLayout from "../components/layout/page-layout.astro";
import Breadcrumbs from "../components/seo/breadcrumbs.astro";
import { SearchIsland } from "../components/search/search-island";
import { getActiveIcons } from "../lib/icons-query";
import { SITE_TITLE } from "../consts";
import { breadcrumbSchema } from "../lib/seo";

const icons = await getActiveIcons();

const count = icons.length.toLocaleString("en-US");
const title = `Search ${count} developer icons | ${SITE_TITLE}`;
const description = `Search ${count} developer logos by brand, framework, database or cloud provider. Download the SVG or use the React, Vue or Svelte component.`;

// /search/ renders its results in the browser, so it is noindex (the crawlable
// catalog is /icons/) and carries no ItemList of links it doesn't render.
const jsonLd = [
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Search", url: "/search" },
  ]),
];
---

<PageLayout title={title} description={description} image="/og/search.png" jsonLd={jsonLd} noindex>
  <div class="max-w-[1400px] mx-auto px-6 pt-8">
    <Breadcrumbs
      items={[
        { name: "Home", url: "/" },
        { name: "Search" },
      ]}
    />
    <header class="mt-6 pb-6">
      <p class="type-label mb-4 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"></span>
        {icons.length.toLocaleString("en-US")} icons
      </p>
      <h1 class="type-h1">Search developer icons</h1>
      <p class="type-body-lg mt-3 max-w-[64ch]">
        Find any brand, framework, database, or cloud provider in the Devicons
        library. Free SVGs plus React, Vue, and Svelte components — MIT
        licensed. Prefer to browse? See <a href="/icons/" class="text-accent hover:text-accent-hover">all icons A–Z</a>.
      </p>
    </header>
  </div>
  <SearchIsland client:only="react" />
</PageLayout>
