---
import PageLayout from '../../../components/layout/page-layout.astro';
import Breadcrumbs from '../../../components/seo/breadcrumbs.astro';
import IconGrid from '../../../components/icons/icon-grid.astro';
import {
  getActiveIcons,
  getUniqueTags,
  toListItem,
  slugifyTag,
  formatTagLabel,
} from '../../../lib/icons-query';
import { SITE_TITLE } from '../../../consts';
import {
  breadcrumbSchema,
  collectionPageSchema,
  definedTermSchema,
} from '../../../lib/seo';

export async function getStaticPaths() {
  const tags = await getUniqueTags();
  const icons = await getActiveIcons();
  return tags.map(({ tag, count }) => ({
    params: { tag: slugifyTag(tag) },
    props: {
      rawTag: tag,
      count,
      icons: icons
        .filter(i => i.data.tags.includes(tag))
        .map(toListItem)
        .sort((a, b) =>
          a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }),
        ),
      relatedTags: tags
        .filter(t => t.tag !== tag)
        .slice(0, 12)
        .map(t => ({ ...t, slug: slugifyTag(t.tag) })),
    },
  }));
}

const { rawTag, count, icons, relatedTags } = Astro.props;
const label = formatTagLabel(rawTag);

const title = `${label} Icons — ${count} free developer logos | ${SITE_TITLE}`;
const description = `Browse ${count} ${label.toLowerCase()} icons and logos. Free SVG downloads plus React, Vue, and Svelte components — MIT licensed.`;

const firstFew = icons
  .slice(0, 6)
  .map(i => i.name)
  .join(', ');

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Icons', url: '/icons' },
    { name: label, url: `/icons/tag/${slugifyTag(rawTag)}` },
  ]),
  collectionPageSchema({
    name: `${label} Icons`,
    description,
    url: `/icons/tag/${slugifyTag(rawTag)}`,
    items: icons.map(i => ({ name: i.name, url: `/icons/${i.slug}` })),
  }),
  definedTermSchema({
    name: label,
    description: `Developer brands and tools tagged "${rawTag}" in the Devicons library. ${count} ${count === 1 ? 'icon' : 'icons'}.`,
    url: `/icons/tag/${slugifyTag(rawTag)}`,
  }),
];
---

<PageLayout
  title={title}
  description={description}
  image={`/og/icons/tag/${slugifyTag(rawTag)}.png`}
  keywords={[
    `${label} icons`,
    `${label} logos`,
    `${label} svg`,
    'developer icons',
  ]}
  jsonLd={jsonLd}>
  <div class="max-w-[1400px] mx-auto px-6 pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Icons', url: '/icons' },
        { name: label },
      ]}
    />

    <header class="mt-6 mb-10 pb-8 border-b border-border">
      <p class="type-label mb-4 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        {count}
        {count === 1 ? 'icon' : 'icons'}
      </p>
      <h1 class="type-h1">{label} icons</h1>
      <p class="type-body-lg mt-3 max-w-[64ch]">
        {count} free {label.toLowerCase()} logos, including {firstFew}
        {icons.length > 6 ? ', and more' : ''}. Download optimized SVGs or drop
        them into your React, Vue, or Svelte app.
      </p>
    </header>

    <IconGrid items={icons} />

    <aside class="my-16 pt-8 border-t border-border">
      <h2 class="type-label mb-4 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        Other categories
      </h2>
      <ul class="flex flex-wrap gap-2">
        {
          relatedTags.map(t => (
            <li>
              <a
                href={`/icons/tag/${t.slug}/`}
                class="inline-flex items-center gap-2 px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider border border-border hover:border-accent hover:text-accent transition-colors">
                {formatTagLabel(t.tag)}{' '}
                <span class="text-text-muted">{t.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
    <div class="mt-12"></div>
  </div>
</PageLayout>
