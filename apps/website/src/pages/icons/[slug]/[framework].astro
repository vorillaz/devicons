---
import type { CollectionEntry } from 'astro:content';
import { getIcons } from '../../../lib/icons-query';
import PageLayout from '../../../components/layout/page-layout.astro';
import Breadcrumbs from '../../../components/seo/breadcrumbs.astro';
import IconRender from '../../../components/icons/icon-render.astro';
import { SITE_TITLE } from '../../../consts';
import { toComponentName } from '../../../lib/component-name';
import { fitDescription, fitTitle } from '../../../lib/meta';
import {
  breadcrumbSchema,
  iconBrandSchema,
  iconImageSchema,
} from '../../../lib/seo';

const FRAMEWORKS = ['react', 'vue', 'svelte', 'astro', 'font'] as const;
type Framework = (typeof FRAMEWORKS)[number];

// Snippets mirror the install tabs on the icon page (install-tabs.tsx), which
// in turn mirror the published packages.
const FRAMEWORK_META: Record<
  Framework,
  {
    label: string;
    heading: (name: string) => string;
    pkg: string;
    runtime: string;
    docs: { href: string; label: string };
    buildImport: (cmp: string) => string;
    buildRender: (cmp: string, iconFile: string) => string;
  }
> = {
  react: {
    label: 'React',
    heading: name => `${name} React icon component`,
    pkg: '@dev.icons/react',
    runtime: 'React',
    docs: { href: '/docs/react/', label: 'React guide' },
    buildImport: cmp => `import { ${cmp} } from "@dev.icons/react";`,
    buildRender: cmp => `<${cmp} size={32} />`,
  },
  vue: {
    label: 'Vue',
    heading: name => `${name} Vue icon component`,
    pkg: '@dev.icons/vue',
    runtime: 'Vue',
    docs: { href: '/docs/vue/', label: 'Vue guide' },
    buildImport: cmp => `import { ${cmp} } from "@dev.icons/vue";`,
    buildRender: cmp => `<${cmp} :size="32" />`,
  },
  svelte: {
    label: 'Svelte',
    heading: name => `${name} Svelte icon component`,
    pkg: '@dev.icons/svelte',
    runtime: 'Svelte',
    docs: { href: '/docs/svelte/', label: 'Svelte guide' },
    buildImport: cmp => `import { ${cmp} } from "@dev.icons/svelte";`,
    buildRender: cmp => `<${cmp} size={32} />`,
  },
  astro: {
    label: 'Astro',
    heading: name => `${name} icon for Astro`,
    pkg: '@dev.icons/react',
    runtime: 'Astro',
    docs: { href: '/docs/react/', label: 'React guide (used in Astro)' },
    buildImport: cmp => `---\nimport { ${cmp} } from "@dev.icons/react";\n---`,
    buildRender: cmp => `<${cmp} size={32} client:load />`,
  },
  font: {
    label: 'Icon font',
    heading: name => `${name} icon font class`,
    pkg: 'devicons',
    runtime: 'web font',
    docs: { href: '/docs/icon-font/', label: 'Icon font guide' },
    buildImport: () => `@import "devicons/css";`,
    buildRender: (_cmp, iconFile) => `<i class="devicons devicons-${iconFile}"></i>`,
  },
};

export async function getStaticPaths() {
  const fws = ['react', 'vue', 'svelte', 'astro', 'font'] as const;
  const icons = await getIcons();
  const gated = icons.filter(
    i => !i.data.deprecated && (i.data.popular || i.data.recommended),
  );
  return gated.flatMap(icon =>
    fws.map(fw => ({
      params: { slug: icon.id, framework: fw },
      props: { entry: icon, framework: fw },
    })),
  );
}

const { entry, framework } = Astro.props as {
  entry: CollectionEntry<'icons'>;
  framework: Framework;
};
const { name, description, icons: iconFiles, website, mainColor, license, brandGuidelines } =
  entry.data;
const meta = FRAMEWORK_META[framework];
const iconFile = iconFiles[0] ?? entry.id;
const cmp = toComponentName(iconFile);
// "React React icon component" reads badly; drop the label when the brand
// and the framework share a name.
const heading =
  name.toLowerCase() === meta.label.toLowerCase()
    ? `${name} icon component`
    : meta.heading(name);
// Only the React page is indexable: it carries unique usage content. The
// other frameworks are thin snippet pages that point back to the icon page.
const indexable = framework === 'react';
const monoImport = `import { ${cmp} } from "@dev.icons/react/mono";`;

const title = indexable
  ? fitTitle(
      `${heading} — props & usage | ${SITE_TITLE}`,
      `${heading} | ${SITE_TITLE}`,
      heading,
    )
  : fitTitle(
      `${heading} — copy-ready snippet | ${SITE_TITLE}`,
      `${heading} | ${SITE_TITLE}`,
      heading,
    );
const pageDescription = fitDescription(
  description,
  `Add the ${name} logo to your ${meta.runtime} project with one import from ${meta.pkg}. Copy the snippet or grab the SVG.`,
  `One import from ${meta.pkg}. Copy the snippet or grab the SVG.`,
  `Copy-ready ${meta.runtime} snippet.`,
) || `${name} icon for ${meta.runtime}: copy-ready import and render snippet from ${meta.pkg}, plus the raw SVG. Free, MIT licensed.`;

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Icons', url: '/icons' },
    { name, url: `/icons/${entry.id}` },
    {
      name: meta.label,
      url: `/icons/${entry.id}/${framework}`,
    },
  ]),
  iconBrandSchema({
    name,
    description,
    slug: entry.id,
    website,
    mainColor,
  }),
  iconImageSchema({ name, slug: entry.id, license, brandGuidelines }),
];

const importSnippet = meta.buildImport(cmp);
const renderSnippet = meta.buildRender(cmp, iconFile);
---

<PageLayout
  title={title}
  description={pageDescription}
  image={`/og/icons/${entry.id}.png`}
  imageAlt={`${name} logo`}
  noindex={!indexable}
  jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Icons', url: '/icons' },
        { name, url: `/icons/${entry.id}` },
        { name: meta.label },
      ]}
    />

    <header class="mt-6 mb-8">
      <p class="type-label mb-4 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        {meta.label} · {meta.pkg}
      </p>
      <h1 class="type-display-sm">{heading}</h1>
      {description && (
        <p class="type-body-lg mt-3 max-w-[64ch]">{description}</p>
      )}
    </header>

    <section class="mb-10 p-6 border border-border flex items-center gap-6">
      <IconRender
        iconFile={iconFile}
        name={name}
        size={80}
        className="w-20 h-20 shrink-0"
      />
      <div class="min-w-0">
        <p class="type-mono text-xs text-text-muted uppercase tracking-caps mb-2">
          Install
        </p>
        <code class="type-mono block break-all">npm install {meta.pkg}</code>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="type-label mb-3 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        Import
      </h2>
      <pre class="p-4 border border-border bg-surface overflow-x-auto"><code class="type-mono text-sm whitespace-pre">{importSnippet}</code></pre>
    </section>

    <section class="mb-10">
      <h2 class="type-label mb-3 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        Render
      </h2>
      <pre class="p-4 border border-border bg-surface overflow-x-auto"><code class="type-mono text-sm whitespace-pre">{renderSnippet}</code></pre>
    </section>

    {
      indexable && (
        <>
          <section class="mb-10">
            <h2 class="type-label mb-3 flex items-center gap-3">
              <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent" />
              Props
            </h2>
            <p class="type-body-sm mb-4 max-w-[64ch]">
              <code>{`<${cmp} />`}</code> renders an inline <code>&lt;svg&gt;</code>. It
              accepts every SVG attribute plus these props:
            </p>
            <div class="overflow-x-auto border border-border">
              <table class="w-full text-left text-sm">
                <thead class="bg-surface">
                  <tr>
                    <th class="p-3 font-mono text-xs uppercase tracking-caps text-text-muted">Prop</th>
                    <th class="p-3 font-mono text-xs uppercase tracking-caps text-text-muted">Type</th>
                    <th class="p-3 font-mono text-xs uppercase tracking-caps text-text-muted">Default</th>
                    <th class="p-3 font-mono text-xs uppercase tracking-caps text-text-muted">What it does</th>
                  </tr>
                </thead>
                <tbody class="type-body-sm">
                  <tr class="border-t border-border"><td class="p-3"><code>size</code></td><td class="p-3"><code>number | string</code></td><td class="p-3"><code>"1em"</code></td><td class="p-3">Sets width and height, so the icon scales with the surrounding text by default.</td></tr>
                  <tr class="border-t border-border"><td class="p-3"><code>color</code></td><td class="p-3"><code>string</code></td><td class="p-3"><code>"currentColor"</code></td><td class="p-3">Fill for monochrome icons. Color icons keep their brand colors.</td></tr>
                  <tr class="border-t border-border"><td class="p-3"><code>alt</code></td><td class="p-3"><code>string</code></td><td class="p-3">none</td><td class="p-3">Accessible name, rendered as an SVG <code>&lt;title&gt;</code>.</td></tr>
                  <tr class="border-t border-border"><td class="p-3"><code>mirrored</code></td><td class="p-3"><code>boolean</code></td><td class="p-3"><code>false</code></td><td class="p-3">Flips the icon horizontally.</td></tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="mb-10">
            <h2 class="type-label mb-3 flex items-center gap-3">
              <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent" />
              Size, color and accessibility
            </h2>
            <pre class="p-4 border border-border bg-surface overflow-x-auto"><code class="type-mono text-sm whitespace-pre">{`<${cmp} size={48} alt="${name} logo" className="shrink-0" />`}</code></pre>
          </section>

          <section class="mb-10">
            <h2 class="type-label mb-3 flex items-center gap-3">
              <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent" />
              Monochrome {name} icon
            </h2>
            <p class="type-body-sm mb-3 max-w-[64ch]">
              The <code>/mono</code> entry point exports a single-color version that
              follows <code>currentColor</code>, so it inherits your text color in
              light and dark themes.
            </p>
            <pre class="p-4 border border-border bg-surface overflow-x-auto"><code class="type-mono text-sm whitespace-pre">{`${monoImport}\n\n<${cmp} color="var(--text-muted)" />`}</code></pre>
          </section>

          <section class="mb-10">
            <h2 class="type-label mb-3 flex items-center gap-3">
              <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent" />
              TypeScript and Server Components
            </h2>
            <p class="type-body-sm mb-3 max-w-[64ch]">
              Components are typed and have no hooks, so they render in React Server
              Components, the Next.js app router and any SSR setup. Named imports keep
              the bundle to the icons you use.
            </p>
            <pre class="p-4 border border-border bg-surface overflow-x-auto"><code class="type-mono text-sm whitespace-pre">{`import type { ComponentProps } from "react";\nimport { ${cmp} } from "@dev.icons/react";\n\ntype LogoProps = ComponentProps<typeof ${cmp}>;\n\nexport function StackLogo(props: LogoProps) {\n  return <${cmp} size={24} alt="${name}" {...props} />;\n}`}</code></pre>
          </section>
        </>
      )
    }

    <section class="mt-12 pt-6 border-t border-border">
      <h2 class="type-label mb-3 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        Also available
      </h2>
      <ul class="flex flex-wrap gap-2">
        {
          FRAMEWORKS.filter(f => f !== framework).map(f => (
            <li>
              <a
                href={`/icons/${entry.id}/${f}/`}
                data-astro-prefetch
                class="inline-flex items-center gap-2 px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider border border-border hover:border-accent hover:text-accent transition-colors">
                {FRAMEWORK_META[f].label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`/icons/${entry.id}/`}
            data-astro-prefetch
            class="inline-flex items-center gap-2 px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider border border-border hover:border-accent hover:text-accent transition-colors">
            Full {name} page →
          </a>
        </li>
      </ul>
    </section>

    <nav class="mt-12 pt-6 border-t border-border">
      <a
        href={meta.docs.href}
        data-astro-prefetch
        class="font-mono text-xs font-semibold uppercase tracking-caps text-text-muted hover:text-accent transition-colors">
        {meta.docs.label} →
      </a>
    </nav>
  </div>
</PageLayout>
