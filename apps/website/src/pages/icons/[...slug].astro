---
import { render, type CollectionEntry } from "astro:content";
import { getIcons } from "../../lib/icons-query";
import Icon from "../../layouts/Icon.astro";

export async function getStaticPaths() {
  const icons = await getIcons();
  const sorted = [...icons].sort((a, b) =>
    a.data.name.localeCompare(b.data.name, undefined, { sensitivity: "base" }),
  );
  return sorted.map((icon, index) => {
    const prev = sorted[index - 1];
    const next = sorted[index + 1];
    return {
      params: { slug: icon.id },
      props: {
        entry: icon,
        prev: prev ? { slug: prev.id, name: prev.data.name } : null,
        next: next ? { slug: next.id, name: next.data.name } : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props as {
  entry: CollectionEntry<"icons">;
  prev: { slug: string; name: string } | null;
  next: { slug: string; name: string } | null;
};
const { Content } = await render(entry);
---

<Icon {...entry.data} slug={entry.id} prev={prev} next={next}>
  <Content />
</Icon>
