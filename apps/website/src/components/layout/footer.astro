---
import {
  getFooterTags,
  slugifyTag,
  formatTagLabel,
} from '../../lib/icons-query';

const year = new Date().getFullYear();
const topTags = (await getFooterTags()).slice(0, 8);
import ExploreAiSummary from '../seo/explore-ai-summary.astro';

interface Props {
  brand?: string;
}
const { brand } = Astro.props;
---

<footer class="footer-brutalist border-t-2 border-border">
  <div class="footer-brand-mark" aria-hidden="true"></div>
  <ExploreAiSummary brand={brand} />
  <div class="max-w-[1400px] mx-auto border-t-2 border-border">
    <div class="footer-grid">
      <div class="footer-col">
        <p class="footer-col__label">[ Browse ]</p>
        <ul class="footer-links">
          <li><a href="/icons/">All icons</a></li>
          <li><a href="/icons/popular/">Popular</a></li>
          <li><a href="/packs/">Packs</a></li>
          <li><a href="/compare/">Compare</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col__label">[ Categories ]</p>
        <ul class="footer-links">
          {
            topTags.map(({ tag }) => (
              <li>
                <a href={`/icons/tag/${slugifyTag(tag)}/`}>
                  {formatTagLabel(tag)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col__label">[ Links ]</p>
        <ul class="footer-links">
          <li>
            <a
              href="https://github.com/vorillaz/devicons"
              target="_blank"
              rel="noopener noreferrer">GitHub ↗</a
            >
          </li>
          <li>
            <a
              href="https://www.npmjs.com/package/@dev.icons/react"
              target="_blank"
              rel="noopener noreferrer">npm ↗</a
            >
          </li>
          <li><a href="/docs/">Documentation</a></li>
          <li><a href="/legal/">Legal</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col__label">[ Project ]</p>
        <p class="footer-col__body">
          Open source. Crisp and clear icons for developers.
        </p>
        <div class="footer-col__meta">
          <span>© {year}</span>
          <span class="footer-col__rule" aria-hidden="true"></span>
          <span>DEVICONS</span>
        </div>
        <div class="mt-4">
          <button
            type="button"
            data-theme-toggle
            aria-label="Toggle theme"
            class="theme-toggle">
            <span class="theme-toggle__option" data-theme-opt="dark">
              <span
                class="theme-toggle__swatch theme-toggle__swatch--dark"
                aria-hidden="true"></span>
              <span>DARK</span>
            </span>
            <span class="theme-toggle__sep" aria-hidden="true">/</span>
            <span class="theme-toggle__option" data-theme-opt="light">
              <span
                class="theme-toggle__swatch theme-toggle__swatch--light"
                aria-hidden="true"></span>
              <span>LIGHT</span>
            </span>
          </button>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-bottom__tag">// END_OF_FILE</span>
      <span class="footer-bottom__coord">001 / 001</span>
    </div>
  </div>
</footer>

<style>
  .footer-brutalist {
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 11px,
        color-mix(in oklab, var(--c-border) 35%, transparent) 11px 12px
      ),
      var(--c-bg);
  }

  .footer-brand-mark {
    position: relative;
    padding: 2rem 0;
    overflow: hidden;
    user-select: none;
  }
  @media (min-width: 768px) {
    .footer-brand-mark {
      padding: 4rem 0;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer-col {
    padding: 1.75rem 1.25rem;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
  }
  @media (min-width: 640px) {
    .footer-col {
      padding: 2rem 1.5rem;
      border-right: 1px solid var(--c-border);
    }
    .footer-col:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (min-width: 1024px) {
    .footer-col {
      border-bottom: 0;
      border-right: 1px solid var(--c-border);
    }
    .footer-col:nth-child(2n) {
      border-right: 1px solid var(--c-border);
    }
    .footer-col:last-child {
      border-right: 0;
    }
  }

  .footer-col__label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-text);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--c-border);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .footer-links li {
    border-bottom: 1px solid
      color-mix(in oklab, var(--c-border) 60%, transparent);
  }
  .footer-links li:last-child {
    border-bottom: 0;
  }

  .footer-links a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-text-secondary);
    text-transform: lowercase;
    transition:
      color 0.12s ease,
      background 0.12s ease,
      padding 0.12s ease;
  }

  .footer-links a::before {
    content: '›';
    color: var(--c-text-muted);
    font-weight: 700;
    transition: color 0.12s ease;
  }

  .footer-links a:hover {
    color: var(--c-accent);
    background: color-mix(in oklab, var(--c-accent) 6%, transparent);
    padding-left: 0.5rem;
  }

  .footer-links a:hover::before {
    color: var(--c-accent);
  }

  .footer-col__body {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.55;
    color: var(--c-text-secondary);
    margin-bottom: 0.75rem;
  }

  .footer-col__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
  }

  .footer-col__rule {
    display: inline-block;
    width: 1px;
    height: 10px;
    background: var(--c-border);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 2px solid var(--c-border);
    padding: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    background: var(--c-surface);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--c-text-muted);
    transition: border-color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--c-accent);
  }

  .theme-toggle__option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .theme-toggle__option[data-active] {
    color: var(--c-accent);
    background: color-mix(in oklab, var(--c-accent) 8%, transparent);
  }

  .theme-toggle__sep {
    color: var(--c-border);
    padding: 0;
    font-weight: 400;
  }

  .theme-toggle__swatch {
    display: inline-block;
    width: 8px;
    height: 8px;
    border: 1px solid var(--c-border);
    flex-shrink: 0;
  }

  .theme-toggle__swatch--dark {
    background: #000;
  }

  .theme-toggle__swatch--light {
    background: #fff;
  }

  .footer-brand-mark::before {
    content: 'DEVICONS';
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    font-size: clamp(6rem, 20vw, 28rem);
    letter-spacing: -0.06em;
    color: var(--c-text);
    opacity: 0.04;
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.querySelector<HTMLButtonElement>(
      '[data-theme-toggle]',
    );
    const optDark = document.querySelector<HTMLElement>(
      '[data-theme-opt="dark"]',
    );
    const optLight = document.querySelector<HTMLElement>(
      '[data-theme-opt="light"]',
    );

    function applyTheme(theme: 'light' | 'dark') {
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
      if (optDark && optLight) {
        if (theme === 'dark') {
          optDark.setAttribute('data-active', '');
          optLight.removeAttribute('data-active');
        } else {
          optLight.setAttribute('data-active', '');
          optDark.removeAttribute('data-active');
        }
      }
    }

    const initial =
      (localStorage.getItem('theme') as 'light' | 'dark' | null) === 'light'
        ? 'light'
        : 'dark';
    applyTheme(initial);

    btn?.addEventListener('click', () => {
      const current =
        localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
