---
const GITHUB_REPO = 'https://github.com/vorillaz/devicons';
const raw = Astro.url.pathname;
const pathname = raw.length > 1 && raw.endsWith('/') ? raw.slice(0, -1) : raw;
const isDocs = pathname === '/docs' || pathname.startsWith('/docs/');
const isSearch = pathname === '/search' || pathname.startsWith('/search/');
const navLinks = [
  { href: '/icons', label: 'All Icons', active: pathname === '/icons' },
  { href: '/search', label: 'Search', active: isSearch },
  { href: '/docs', label: 'Docs', active: isDocs },
];
---

<header
  class="navbar-brutalist fixed top-0 left-0 right-0 z-50 bg-bg border-b-2 border-border"
  transition:persist="navbar"
  transition:animate="none">
  <div
    class="max-w-[1400px] mx-auto h-14 flex items-stretch justify-between">
    <a
      href="/"
      class="navbar-brand group"
      aria-label="DEVICONS home">
      <span class="navbar-brand__plate" aria-hidden="true">
        <svg
          class="navbar-logo-mark"
          width="22"
          height="22"
          viewBox="0 0 128 128">
          <polygon points="0,0 128,0 128,128 16,128 0,112" fill="currentColor"
          ></polygon>
          <text
            x="64"
            y="100"
            text-anchor="middle"
            font-family="system-ui,-apple-system,sans-serif"
            font-weight="900"
            font-size="100"
            letter-spacing="-4"
            fill="var(--c-bg)">D</text
          >
        </svg>
      </span>
      <span class="navbar-brand__text">
        <span class="navbar-brand__name">DEVICONS</span>
        <span class="navbar-brand__meta" aria-hidden="true">// v1</span>
      </span>
    </a>

    <nav class="navbar-nav">
      {
        navLinks.map(link => (
          <a
            href={link.href}
            data-nav-link
            data-match={link.href}
            class:list={[
              'navbar-link navbar-nav__item hidden sm:inline-flex',
              link.active && 'is-active',
            ]}>
            {link.label}
          </a>
        ))
      }
      <a
        href={GITHUB_REPO}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View Devicons on GitHub"
        class="btn btn--ghost btn--mono btn--sm hidden sm:inline-flex navbar-gh">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="shrink-0"
          aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
        <span class="hidden sm:block">GitHub</span>
        <span
          data-stars
          class="hidden sm:inline-flex items-center gap-1 px-1.5 py-0.5 bg-bg border border-border type-mono-sm text-accent">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="shrink-0"
            aria-hidden="true">
            <polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon>
          </svg>
          <span
            data-stars-value
            class="inline-block min-w-[2ch] tabular-nums"
            aria-live="polite"
            aria-busy="true">....</span
          >
        </span>
      </a>

      <button
        type="button"
        data-mobile-menu-trigger
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="sm:hidden inline-flex items-center justify-center h-14 w-14 border-l-2 border-border bg-surface text-text hover:border-l-accent hover:text-accent transition-colors">
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true">
          <line x1="2" y1="4" x2="14" y2="4"></line>
          <line x1="2" y1="8" x2="14" y2="8"></line>
          <line x1="2" y1="12" x2="14" y2="12"></line>
        </svg>
      </button>
    </nav>
  </div>

  <div
    id="mobile-menu"
    data-mobile-menu
    data-state="closed"
    aria-hidden="true"
    class="mobile-menu sm:hidden">
    <div data-mobile-menu-overlay class="mobile-menu__overlay"></div>

    <aside
      role="dialog"
      aria-modal="true"
      aria-label="Mobile menu"
      data-mobile-menu-panel
      class="mobile-menu__panel bg-bg border-l border-border flex flex-col">
      <div
        class="h-14 flex items-center justify-between px-6 border-b border-border shrink-0">
        <span class="type-label">Menu</span>
        <button
          type="button"
          data-mobile-menu-close
          aria-label="Close menu"
          class="inline-flex items-center justify-center w-9 h-9 border border-border bg-surface text-text hover:border-accent hover:text-accent transition-colors">
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true">
            <line x1="3" y1="3" x2="13" y2="13"></line>
            <line x1="13" y1="3" x2="3" y2="13"></line>
          </svg>
        </button>
      </div>

      <nav class="flex flex-col py-2" aria-label="Primary">
        {
          navLinks.map(link => (
            <a
              href={link.href}
              data-nav-link-mobile
              data-match={link.href}
              class:list={[
                'navbar-link px-6 py-4 border-b border-border transition-colors',
                link.active
                  ? 'text-accent bg-surface is-active'
                  : 'text-text hover:text-accent hover:bg-surface',
              ]}>
              {link.label}
            </a>
          ))
        }
        <a
          href={GITHUB_REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="navbar-link px-6 py-4 border-b border-border text-text hover:text-accent hover:bg-surface transition-colors flex items-center gap-2">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="shrink-0"
            aria-hidden="true">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
            ></path>
          </svg>
          GitHub
        </a>
      </nav>
    </aside>
  </div>
</header>

<style>
  .navbar-brutalist {
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 11px,
        color-mix(in oklab, var(--c-border) 35%, transparent) 11px 12px
      ),
      var(--c-bg);
  }

  .navbar-brand {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    border-right: 1px solid var(--c-border);
    transition: color 0.15s ease;
  }

  .navbar-brand__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    border-right: 1px solid var(--c-border);
    background: var(--c-surface);
    transition: background 0.15s ease;
  }

  .navbar-brand:hover .navbar-brand__plate {
    background: color-mix(in oklab, var(--c-accent) 10%, var(--c-surface));
  }

  .navbar-brand__text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1rem;
  }

  .navbar-brand__name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--c-text);
    transition: color 0.15s ease;
  }

  .navbar-brand:hover .navbar-brand__name {
    color: var(--c-accent);
  }

  .navbar-brand__meta {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    display: none;
  }
  @media (min-width: 768px) {
    .navbar-brand__meta {
      display: inline;
    }
  }

  .navbar-logo-mark {
    color: var(--c-accent);
    transition: color 0.15s ease;
  }
  .group:hover .navbar-logo-mark {
    color: var(--c-accent-hover);
  }

  .navbar-nav {
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  .navbar-nav__item {
    display: none;
    align-items: center;
    gap: 0.25rem;
    padding: 0 1rem;
    border-left: 1px solid var(--c-border);
    color: var(--c-text-muted);
    transition:
      color 0.12s ease,
      background 0.12s ease;
  }
  @media (min-width: 640px) {
    .navbar-nav__item {
      display: inline-flex;
    }
  }

  .navbar-nav__item:hover {
    color: var(--c-text);
    background: color-mix(in oklab, var(--c-accent) 6%, transparent);
  }

  .navbar-nav__item.is-active {
    color: var(--c-accent);
    background: color-mix(in oklab, var(--c-accent) 10%, transparent);
  }

  /* Brackets always occupy space so toggling active doesn't shift layout.
     Transparent by default, colored when active. */
  .navbar-nav__item::before,
  .navbar-nav__item::after {
    font-family: var(--font-mono);
    font-weight: 700;
    color: transparent;
    opacity: 0;
    transition:
      color 0.3s ease-out,
      opacity 0.3s ease-out;
  }
  .navbar-nav__item.is-active::before,
  .navbar-nav__item.is-active::after {
    opacity: 1;
  }
  .navbar-nav__item::before {
    content: '[';
    margin-right: 0.25rem;
  }
  .navbar-nav__item::after {
    content: ']';
    margin-left: 0.25rem;
  }
  .navbar-nav__item.is-active::before,
  .navbar-nav__item.is-active::after {
    color: var(--c-accent);
  }

  .navbar-gh {
    align-self: center;
    margin: 0 0.75rem;
  }
</style>

<script>
  const CACHE_KEY = 'devicons:gh-stars';
  const TTL_MS = 60 * 60 * 1000;

  function format(n: number): string {
    if (n >= 1000) return `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k`;
    return String(n);
  }

  function readCache(): { count: number; ts: number } | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (typeof parsed?.count === 'number' && typeof parsed?.ts === 'number') {
        return parsed;
      }
    } catch {}
    return null;
  }

  function writeCache(count: number) {
    try {
      localStorage.setItem(
        CACHE_KEY,
        JSON.stringify({ count, ts: Date.now() }),
      );
    } catch {}
  }

  function initStars() {
    const valueEl = document.querySelector<HTMLElement>('[data-stars-value]');
    if (!valueEl) return;

    function render(count: number) {
      valueEl!.textContent = format(count);
      valueEl!.removeAttribute('aria-busy');
    }

    function fetchStars() {
      fetch('https://api.github.com/repos/vorillaz/devicons')
        .then(r => (r.ok ? r.json() : Promise.reject()))
        .then(data => {
          if (typeof data?.stargazers_count === 'number') {
            writeCache(data.stargazers_count);
            render(data.stargazers_count);
          }
        })
        .catch(() => {});
    }

    const cached = readCache();
    if (cached) render(cached.count);

    const fresh = cached && Date.now() - cached.ts < TTL_MS;
    if (!fresh) {
      const ric = (
        window as unknown as {
          requestIdleCallback?: (
            cb: () => void,
            opts?: { timeout: number },
          ) => number;
        }
      ).requestIdleCallback;
      if (ric) ric(fetchStars, { timeout: 2500 });
      else setTimeout(fetchStars, 1500);
    }
  }

  // Run on initial load and after every view transition
  document.addEventListener('astro:page-load', initStars);
</script>

<script>
  // The navbar persists across navigations, so the server-rendered
  // `is-active` class is stuck on the first-visited page. Recompute it
  // during the view-transition swap so the bracket fade lines up with
  // the page fade instead of flashing after the transition finishes.
  // Strip trailing slash so `/icons/` matches the href `/icons`.
  const norm = (p: string) => p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p;

  const matchesPath = (target: string, pathname: string) => {
    const p = norm(pathname);
    if (target === '/') return p === '/';
    if (target === '/search') {
      return p === '/search' || p.startsWith('/search/');
    }
    if (target === '/docs') {
      return p === '/docs' || p.startsWith('/docs/');
    }
    return p === target;
  };

  function syncActiveLink(pathname: string) {
    document
      .querySelectorAll<HTMLAnchorElement>(
        '[data-nav-link], [data-nav-link-mobile]',
      )
      .forEach((a) => {
        const target = a.dataset.match ?? a.getAttribute('href') ?? '';
        a.classList.toggle('is-active', matchesPath(target, pathname));
      });
  }

  // Initial paint on hard load.
  syncActiveLink(window.location.pathname);

  // Fire before the DOM swap so the bracket fade coordinates with the
  // main-content fade — the user perceives one synchronized transition.
  document.addEventListener(
    'astro:before-preparation',
    (e: Event & { to?: URL }) => {
      if (e.to) syncActiveLink(e.to.pathname);
    },
  );

  // Safety net in case the event above didn't carry a URL (older ClientRouter
  // builds) — reconcile once the new document is live.
  document.addEventListener('astro:after-swap', () =>
    syncActiveLink(window.location.pathname),
  );
</script>

<script>
  import { setupMobileMenu } from '../../lib/mobile-menu';
  document.addEventListener('astro:page-load', () => {
    setupMobileMenu({
      key: 'mobile-menu',
      breakpoint: '(min-width: 640px)',
      closeOnPanelLinkClick: true,
    });
  });
</script>
