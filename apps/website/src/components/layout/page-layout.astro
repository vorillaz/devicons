---
import BaseHead from '../head.astro';
import Navbar from './navbar.astro';
import Footer from './footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  brand?: string;
}

const { brand, ...props } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
  </head>
  <body class="bg-bg text-text">
    <Navbar />
    <main class="pt-14" transition:animate="fade">
      <slot />
    </main>
    <Footer brand={brand} />
  <!-- impeccable-live-start -->
<script is:inline src="http://localhost:8400/live.js?token=ced3aeb1-32b6-45d2-ae64-ff67e952ca03"></script>
<!-- impeccable-live-end -->
</body>
</html>
