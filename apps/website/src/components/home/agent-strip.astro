---
// Hero strip: one-line setup for each agent surface (MCP, CLI, API, Skill).
// CSS-only tabs (radio inputs) so it adds no client island; one small script
// handles the copy buttons. Every command and docs link is in the HTML.
const TABS = [
  {
    id: 'mcp',
    label: 'MCP',
    command: 'claude mcp add --transport http devicons https://devicons.io/api/mcp',
    href: '/docs/mcp/',
    docs: 'MCP setup',
  },
  {
    id: 'cli',
    label: 'CLI',
    command: 'npx devicons search react',
    href: '/docs/cli/',
    docs: 'CLI docs',
  },
  {
    id: 'api',
    label: 'API',
    command: 'curl "https://devicons.io/api/v1/search?q=react"',
    href: '/docs/api/',
    docs: 'API docs',
  },
  {
    id: 'skill',
    label: 'Skill',
    command: 'Read https://devicons.io/skill.md and follow it to add icons.',
    href: '/docs/skill/',
    docs: 'Skill docs',
  },
] as const;
---

<fieldset class="agent-strip">
  <legend class="agent-strip__legend type-label">
    <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"></span>
    Agent-ready
    <a href="/docs/agents/" class="agent-strip__all">Use with AI agents →</a>
  </legend>

  {
    TABS.map((tab, i) => (
      <input
        type="radio"
        name="agent-strip"
        id={`agent-tab-${tab.id}`}
        class="agent-strip__radio sr-only"
        checked={i === 0}
      />
    ))
  }

  <div class="agent-strip__tabs">
    {TABS.map(tab => <label for={`agent-tab-${tab.id}`}>{tab.label}</label>)}
  </div>

  <div class="agent-strip__panels">
    {
      TABS.map(tab => (
        <div class={`agent-strip__panel agent-strip__panel--${tab.id}`}>
          <code class="agent-strip__command">{tab.command}</code>
          <button type="button" class="agent-strip__copy" data-copy={tab.command}>
            Copy
          </button>
          <a href={tab.href} class="agent-strip__docs" aria-label={tab.docs}>
            Docs →
          </a>
        </div>
      ))
    }
  </div>
</fieldset>

<style>
  .agent-strip {
    margin-top: var(--space-8);
    max-width: 38rem;
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .agent-strip__legend {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    margin-bottom: var(--space-3);
  }
  .agent-strip__all {
    margin-left: auto;
    color: var(--c-text-muted);
    text-transform: none;
    letter-spacing: normal;
  }
  .agent-strip__all:hover {
    color: var(--c-accent);
  }

  .agent-strip__tabs {
    display: flex;
    border: 1px solid var(--c-border);
    border-bottom: 0;
    width: fit-content;
  }
  .agent-strip__tabs label {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    cursor: pointer;
    border-right: 1px solid var(--c-border);
    transition:
      color 120ms ease,
      background-color 120ms ease;
  }
  .agent-strip__tabs label:last-child {
    border-right: 0;
  }
  .agent-strip__tabs label:hover {
    color: var(--c-text);
  }

  .agent-strip__panel {
    display: none;
    align-items: stretch;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    min-width: 0;
  }

  .agent-strip__command {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: thin;
    color: var(--c-text);
  }
  .agent-strip__command::before {
    content: '$ ';
    color: var(--c-accent);
  }
  .agent-strip__panel--skill .agent-strip__command::before {
    content: '> ';
  }

  .agent-strip__copy,
  .agent-strip__docs {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-3);
    border-left: 1px solid var(--c-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c-text-muted);
    transition: color 120ms ease;
  }
  .agent-strip__copy:hover,
  .agent-strip__docs:hover {
    color: var(--c-accent);
  }
  .agent-strip__copy[data-copied] {
    color: var(--c-accent);
  }

  /* Tab state: the checked radio shows its panel and highlights its label. */
  #agent-tab-mcp:checked ~ .agent-strip__panels .agent-strip__panel--mcp,
  #agent-tab-cli:checked ~ .agent-strip__panels .agent-strip__panel--cli,
  #agent-tab-api:checked ~ .agent-strip__panels .agent-strip__panel--api,
  #agent-tab-skill:checked ~ .agent-strip__panels .agent-strip__panel--skill {
    display: flex;
  }
  #agent-tab-mcp:checked ~ .agent-strip__tabs label[for='agent-tab-mcp'],
  #agent-tab-cli:checked ~ .agent-strip__tabs label[for='agent-tab-cli'],
  #agent-tab-api:checked ~ .agent-strip__tabs label[for='agent-tab-api'],
  #agent-tab-skill:checked ~ .agent-strip__tabs label[for='agent-tab-skill'] {
    color: var(--c-accent-fg);
    background: var(--c-accent);
  }
  #agent-tab-mcp:focus-visible ~ .agent-strip__tabs label[for='agent-tab-mcp'],
  #agent-tab-cli:focus-visible ~ .agent-strip__tabs label[for='agent-tab-cli'],
  #agent-tab-api:focus-visible ~ .agent-strip__tabs label[for='agent-tab-api'],
  #agent-tab-skill:focus-visible ~ .agent-strip__tabs label[for='agent-tab-skill'] {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .agent-strip__docs {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('click', async event => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy]');
    if (!button?.closest('.agent-strip')) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copied';
      button.dataset.copied = '';
      setTimeout(() => {
        button.textContent = 'Copy';
        delete button.dataset.copied;
      }, 1500);
    } catch {
      // Clipboard unavailable (insecure context or denied): leave the button as is.
    }
  });
</script>
