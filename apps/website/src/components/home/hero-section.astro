---
import fs from 'node:fs';
import path from 'node:path';
import { getEntry } from 'astro:content';
import GeometricGrid from '../layout/geometric-grid.astro';

interface Props {
  iconCount: number;
}

const { iconCount } = Astro.props;

// `icon` is the collection entry the caption links to; `brand` tints the
// glass so each mark reads in its own official colour.
const SHOWCASE = [
  { id: 'react', icon: 'react', label: 'React', svg: '/models/react-logo.svg', dispScale: 22, brand: '#61dafb' },
  { id: 'claude', icon: 'claude', label: 'Claude', svg: '/models/claude-logo.svg', dispScale: 38, brand: '#d97757' },
  { id: 'svelte', icon: 'svelte', label: 'Svelte', svg: '/models/svelte-logo.svg', dispScale: 42, brand: '#ff3e00' },
  { id: 'tailwind', icon: 'tailwind', label: 'Tailwind', svg: '/models/tailwind-logo.svg', dispScale: 40, brand: '#06b6d4' },
  { id: 'vscode', icon: 'visual-studio-code', label: 'VS Code', svg: '/models/vscode-logo.svg', dispScale: 38, brand: '#0098ff' },
  { id: 'vercel', icon: 'vercel', label: 'Vercel', svg: '/models/vercel-logo.svg', dispScale: 42, brand: '#ededed' },
  { id: 'vue', icon: 'vue', label: 'Vue', svg: '/models/vue-logo.svg', dispScale: 38, brand: '#42b883' },
];

const LOGOS = await Promise.all(
  SHOWCASE.map(async logo => {
    const entry = await getEntry('icons', logo.icon);
    return {
      ...logo,
      href: `/icons/${logo.icon}/`,
      styles: entry?.data.icons.length ?? 1,
    };
  }),
);

const initial = LOGOS[0];
const pad = (n: number) => String(n).padStart(2, '0');
const stylesLabel = (n: number) => `${n} ${n === 1 ? 'style' : 'styles'}`;

const publicDir = path.join(process.cwd(), 'public');
const initialRaw = fs.readFileSync(
  path.join(publicDir, initial.svg.replace(/^\//, '')),
  'utf-8',
);
const initialSvgData = initialRaw
  .replace(/<\?xml[^?]*\?>\s*/, '')
  .replace(/\s+/g, ' ')
  .trim();
const initialDataUrl = `data:image/svg+xml;utf8,${encodeURIComponent(initialSvgData)}`;
---

<section class="hero relative flex flex-col overflow-hidden">
  <GeometricGrid />

  <div
    class="hero-content relative z-10 flex-1 flex flex-col justify-center px-4 sm:px-6 max-w-[1400px] mx-auto w-full">
    <div
      class="flex flex-col md:flex-row md:justify-between md:items-center gap-8 md:gap-12">
      <div class="flex-1 min-w-0">
        <p class="hero-eyebrow type-label mb-4 sm:mb-5 flex items-center gap-3">
          <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
          ></span>
          {iconCount.toLocaleString('en-US')} Icons / MIT / Open Source
        </p>
        <h1 class="hero-title">
          Developer icons & logos for people who ship.
        </h1>
        <p class="hero-lead type-body-lg mt-5 sm:mt-6">
          Free SVGs plus React, Vue, Svelte, and Astro components — MIT
          licensed.
        </p>
        <div
          class="hero-actions flex flex-wrap items-center gap-3 mt-6 sm:mt-8">
          <a href="#icons" class="btn btn--primary btn--mono"> Browse Icons </a>
          <a
            href="/icons/popular/"
            class="btn btn--mono"
            data-astro-prefetch="viewport">
            Popular
          </a>
        </div>
      </div>

      <div
        class="hero-visual hidden md:flex flex-col items-center"
        style={`--brand: ${initial.brand}`}>
      <div
        class="hero-logo flex cursor-pointer items-center justify-center"
        data-logos={JSON.stringify(LOGOS)}
        role="button"
        tabindex="0"
        aria-label="Show the next showcase logo">
        <div
          class="hero-glass-shape"
          data-glass-shape
          style={`--logo: url("${initialDataUrl}")`}
          aria-hidden="true">
          <div class="hero-glass-refract" aria-hidden="true"></div>
          <div class="hero-glass-depth" aria-hidden="true"></div>
          <div class="hero-glass-highlight" aria-hidden="true"></div>
          <div class="hero-glass-specular" aria-hidden="true"></div>
        </div>
      </div>
      <a class="hero-caption" href={initial.href} data-hero-caption>
        <span class="hero-caption__index" data-caption-index
          >{pad(1)} / {pad(LOGOS.length)}</span
        >
        <span class="hero-caption__swatch" aria-hidden="true"></span>
        <span class="hero-caption__name" data-caption-name>{initial.label}</span>
        <span class="hero-caption__meta" data-caption-meta
          >{stylesLabel(initial.styles)}</span
        >
        <span class="hero-caption__arrow" aria-hidden="true">→</span>
      </a>
      </div>

      <svg
        class="hero-glass-defs"
        aria-hidden="true"
        focusable="false"
        width="0"
        height="0">
        <defs></defs>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 70dvh;
  }
  @media (min-width: 768px) {
    .hero {
      min-height: calc(100dvh - 56px);
    }
  }

  .hero-eyebrow,
  .hero-actions {
    animation: heroFadeUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }
  .hero-eyebrow {
    animation-delay: 0.1s;
  }
  .hero-actions {
    animation-delay: 0.2s;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0.6;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Headline sized to the half-width column so it sets in 2-3 even lines
     instead of five ragged ones. */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.4vw, 4.75rem);
    font-weight: 900;
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
    color: var(--c-text);
    text-wrap: balance;
    max-width: 16ch;
  }
  .hero-lead {
    max-width: 44ch;
    animation: heroFadeUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s both;
  }

  .hero-visual {
    align-self: center;
    gap: var(--space-4);
  }

  /* Specimen label under the showcase mark. */
  .hero-caption {
    margin-top: calc(var(--space-8) * -1);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--c-border);
    background: var(--c-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    line-height: var(--leading-flat);
    color: var(--c-text-muted);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .hero-caption:hover {
    border-color: var(--c-text-muted);
    color: var(--c-text);
  }
  .hero-caption__swatch {
    width: 8px;
    height: 8px;
    background: var(--brand);
    transition: background-color 0.4s ease;
  }
  .hero-caption__name {
    color: var(--c-text);
  }
  .hero-caption__arrow {
    color: var(--c-accent);
  }

  .hero-logo {
    position: relative;
    width: 420px;
    height: 420px;
    animation: heroFadeIn 0.8s ease 0.2s both;
    isolation: isolate;
  }
  @media (min-width: 1024px) {
    .hero-logo {
      width: 460px;
      height: 460px;
    }
  }
  @media (min-width: 1280px) {
    .hero-logo {
      width: 640px;
      height: 640px;
    }
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0.4;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-glass-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  @property --sx {
    syntax: '<number>';
    inherits: true;
    initial-value: 32;
  }
  @property --sy {
    syntax: '<number>';
    inherits: true;
    initial-value: 22;
  }

  .hero-glass-shape {
    position: relative;
    width: 78%;
    height: 78%;
    --liquid-filter-id: url(#heroLiquid-fallback);
    filter: drop-shadow(
        0 0 36px color-mix(in srgb, var(--brand) 32%, transparent)
      )
      drop-shadow(0 2px 2px rgba(255, 255, 255, 0.08))
      drop-shadow(0 18px 28px rgba(0, 0, 0, 0.45))
      drop-shadow(0 42px 80px rgba(0, 0, 0, 0.65));
  }

  .hero-glass-shape > * {
    position: absolute;
    inset: 0;
    pointer-events: none;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  /* 1. Lens + frosted material body. Directional gradient fakes
        convex thickness. Heavier blur so the grid blooms through the
        glass like frost, but saturation + brightness still let
        colour from the radial wash pick up. */
  .hero-glass-refract {
    background: linear-gradient(
      158deg,
      var(--glass-hi, rgba(255, 255, 255, 0.32)) 0%,
      var(--glass-mid, rgba(255, 255, 255, 0.16)) 28%,
      var(--glass-lo, color-mix(in srgb, var(--brand) 22%, transparent)) 55%,
      var(--glass-tint-a, color-mix(in srgb, var(--brand) 48%, transparent))
        80%,
      var(--glass-tint-b, color-mix(in srgb, var(--brand) 62%, transparent))
        100%
    );
    backdrop-filter: var(--liquid-filter-id) blur(16px) saturate(1.9)
      brightness(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.9) brightness(1.1);
    will-change: backdrop-filter;
  }

  /* 2. Inner light — very subtle top lift + bottom counter-glow.
        Dialed way down; glass must read transparent, not frosted. */
  .hero-glass-depth {
    background:
      radial-gradient(
        95% 65% at 50% 6%,
        rgba(255, 255, 255, 0.5) 0%,
        rgba(255, 255, 255, 0.12) 34%,
        transparent 62%
      ),
      radial-gradient(
        110% 55% at 55% 105%,
        rgba(220, 230, 250, 0.38) 0%,
        rgba(210, 225, 255, 0.1) 38%,
        transparent 64%
      ),
      radial-gradient(
        120% 120% at 50% 50%,
        transparent 54%,
        rgba(0, 0, 0, 0.3) 88%,
        rgba(0, 0, 0, 0.55) 100%
      );
    mix-blend-mode: plus-lighter;
  }

  /* 3. Edge — thin sharp rim light at top (and softer one at bottom).
        The signature "line light" of real transparent curved glass. */
  .hero-glass-highlight {
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 1) 0%,
        rgba(255, 255, 255, 0.55) 2.5%,
        rgba(255, 255, 255, 0.1) 7%,
        transparent 14%
      ),
      radial-gradient(
        ellipse 60% 30% at 36% 5%,
        rgba(255, 255, 255, 0.95) 0%,
        rgba(255, 255, 255, 0.32) 30%,
        rgba(255, 255, 255, 0.06) 58%,
        transparent 76%
      ),
      linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.6) 0%,
        rgba(255, 255, 255, 0.18) 3.5%,
        rgba(255, 255, 255, 0.02) 9%,
        transparent 15%
      );
    mix-blend-mode: plus-lighter;
    opacity: 1;
  }

  /* 4. Specular — pointer-reactive bright reflection on the curved
        surface. Moves with the cursor with a gentle ease. */
  .hero-glass-specular {
    background:
      radial-gradient(
        ellipse 22% 15% at calc(var(--sx) * 1%) calc(var(--sy) * 1%),
        rgba(255, 255, 255, 1) 0%,
        rgba(255, 255, 255, 0.55) 30%,
        rgba(255, 255, 255, 0.12) 62%,
        transparent 82%
      ),
      radial-gradient(
        ellipse 10% 7% at calc((var(--sx) + 18) * 1%) calc((var(--sy) + 8) * 1%),
        rgba(255, 235, 210, 0.55) 0%,
        transparent 72%
      );
    mix-blend-mode: plus-lighter;
    opacity: 0.95;
    transition:
      --sx 0.4s cubic-bezier(0.2, 0.6, 0.3, 1),
      --sy 0.4s cubic-bezier(0.2, 0.6, 0.3, 1),
      opacity 0.3s ease;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .hero-glass-refract {
      background: linear-gradient(
        158deg,
        rgba(255, 255, 255, 0.3) 0%,
        rgba(255, 255, 255, 0.14) 50%,
        rgba(150, 175, 215, 0.22) 100%
      );
    }
  }

  /* Light-mode glass. On a bright backdrop, brightening the glass
        erases it — instead we darken slightly, keep a warm-grey tint,
        and invert the depth vignette so the rim reads dark and the
        centre stays neutral. Highlights stay bright-white (they still
        read because plus-lighter clamps). */
  :global([data-theme='light']) .hero-glass-shape {
    filter: drop-shadow(
        0 0 32px color-mix(in srgb, var(--brand) 28%, transparent)
      )
      drop-shadow(0 2px 2px rgba(0, 0, 0, 0.06))
      drop-shadow(0 18px 28px rgba(0, 0, 0, 0.18))
      drop-shadow(0 42px 80px rgba(0, 0, 0, 0.25));
  }

  :global([data-theme='light']) .hero-glass-refract {
    --glass-hi: rgba(35, 45, 60, 0.28);
    --glass-mid: rgba(50, 65, 85, 0.16);
    --glass-lo: color-mix(in srgb, var(--brand) 18%, transparent);
    --glass-tint-a: color-mix(in srgb, var(--brand) 40%, rgba(40, 55, 80, 0.1));
    --glass-tint-b: color-mix(in srgb, var(--brand) 55%, rgba(30, 45, 70, 0.15));
    backdrop-filter: var(--liquid-filter-id) blur(18px) saturate(1.25)
      brightness(0.94);
    -webkit-backdrop-filter: blur(18px) saturate(1.25) brightness(0.94);
  }

  :global([data-theme='light']) .hero-glass-depth {
    background:
      radial-gradient(
        95% 65% at 50% 6%,
        rgba(255, 255, 255, 0.4) 0%,
        rgba(255, 255, 255, 0.08) 34%,
        transparent 62%
      ),
      radial-gradient(
        110% 55% at 55% 105%,
        rgba(60, 80, 110, 0.18) 0%,
        rgba(60, 80, 110, 0.05) 40%,
        transparent 64%
      ),
      radial-gradient(
        120% 120% at 50% 50%,
        transparent 52%,
        rgba(0, 20, 50, 0.18) 88%,
        rgba(0, 20, 50, 0.3) 100%
      );
    mix-blend-mode: multiply;
  }

  :global([data-theme='light']) .hero-glass-highlight {
    opacity: 0.9;
  }

  :global([data-theme='light']) .hero-glass-specular {
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-lead,
    .hero-actions,
    .hero-logo {
      animation: none;
      opacity: 1;
    }
    .hero-glass-specular {
      transition: none;
    }
  }
</style>

<script>
  import {
    installLogoGlass,
    installIdentityFilter,
    scheduleIdle,
  } from '../effects/logo-glass';

  type Logo = {
    id: string;
    label: string;
    svg: string;
    dispScale: number;
    brand: string;
    href: string;
    styles: number;
  };

  function initHero() {
    const logoEl = document.querySelector<HTMLElement>('.hero-logo');
    const shapeEl = logoEl?.querySelector<HTMLElement>('[data-glass-shape]');
    const defsSvg = document.querySelector<SVGSVGElement>('.hero-glass-defs');

    if (logoEl && shapeEl && defsSvg) {
      const logos = JSON.parse(logoEl.dataset.logos ?? '[]') as Logo[];
      installIdentityFilter(defsSvg, 'heroLiquid-fallback');

      const filterIdFor = (id: string) => `heroLiquid-${id}`;
      const mapReady = new Set<string>();

      const filterSize = Math.max(shapeEl.clientWidth, 1);

      const ensureMap = async (logo: Logo): Promise<boolean> => {
        if (mapReady.has(logo.id)) return true;
        const shader = await installLogoGlass(logo.svg, {
          size: filterSize,
          filterHost: defsSvg,
          filterId: filterIdFor(logo.id),
          strength: (logo.dispScale ?? 24) / 70,
        });
        if (!shader) return false;
        mapReady.add(logo.id);
        return true;
      };

      const pointToFilter = (logo: Logo) => {
        shapeEl.style.setProperty(
          '--liquid-filter-id',
          mapReady.has(logo.id)
            ? `url(#${filterIdFor(logo.id)})`
            : 'url(#heroLiquid-fallback)',
        );
      };

      const setLogoMask = (logo: Logo) => {
        fetch(logo.svg)
          .then(r => r.text())
          .then(text => {
            const compact = text
              .replace(/<\?xml[^?]*\?>\s*/, '')
              .replace(/\s+/g, ' ')
              .trim();
            const dataUrl = `data:image/svg+xml;utf8,${encodeURIComponent(compact)}`;
            shapeEl.style.setProperty('--logo', `url("${dataUrl}")`);
          })
          .catch(() => {
            shapeEl.style.setProperty('--logo', `url("${logo.svg}")`);
          });
      };

      if (logos.length) {
        let idx = 0;
        const first = logos[0];
        if (first) {
          void ensureMap(first).then(() => pointToFilter(first));
        }
        logos.slice(1).forEach(logo => {
          scheduleIdle(() => void ensureMap(logo));
        });

        const visualEl = logoEl.closest<HTMLElement>('.hero-visual');
        const captionEl = visualEl?.querySelector<HTMLAnchorElement>(
          '[data-hero-caption]',
        );
        const pad = (n: number) => String(n).padStart(2, '0');

        const setCaption = (logo: Logo, i: number) => {
          visualEl?.style.setProperty('--brand', logo.brand);
          if (!captionEl) return;
          captionEl.href = logo.href;
          const set = (sel: string, text: string) => {
            const el = captionEl.querySelector(sel);
            if (el) el.textContent = text;
          };
          set('[data-caption-index]', `${pad(i + 1)} / ${pad(logos.length)}`);
          set('[data-caption-name]', logo.label);
          set(
            '[data-caption-meta]',
            `${logo.styles} ${logo.styles === 1 ? 'style' : 'styles'}`,
          );
        };

        const next = () => {
          idx = (idx + 1) % logos.length;
          const logo = logos[idx];
          if (!logo) return;
          setLogoMask(logo);
          setCaption(logo, idx);
          void ensureMap(logo).then(() => pointToFilter(logo));
        };

        logoEl.addEventListener('click', next);
        logoEl.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            next();
          }
        });
      }

      logoEl.addEventListener('pointermove', e => {
        const r = shapeEl.getBoundingClientRect();
        if (r.width === 0 || r.height === 0) return;
        const x = ((e.clientX - r.left) / r.width) * 100;
        const y = ((e.clientY - r.top) / r.height) * 100;
        shapeEl.style.setProperty(
          '--sx',
          String(Math.max(0, Math.min(100, x))),
        );
        shapeEl.style.setProperty(
          '--sy',
          String(Math.max(0, Math.min(100, y))),
        );
      });
      logoEl.addEventListener('pointerleave', () => {
        shapeEl.style.setProperty('--sx', '32');
        shapeEl.style.setProperty('--sy', '22');
      });
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
