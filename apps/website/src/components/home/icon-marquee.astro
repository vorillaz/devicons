---
/*
  Brutalist marquee: single infinite row of flagship icons on hard-edged
  slab tiles separated by 1px dividers. Big mono index, uppercase label,
  hover inverts the entire tile to the accent color. No gradients, no
  rounded corners, no decoration.
*/
import { getCollection } from 'astro:content';
import IconRender from '../icons/icon-render.astro';

interface MarqueeIcon {
  file: string;
  label: string;
  slug?: string;
  badInDark: boolean;
  badInLight: boolean;
}

const SEED: Array<{ file: string; label: string; slug?: string }> = [
  { file: 'vite', label: 'Vite' },
  { file: 'rails-icon', label: 'Rails', slug: 'rails' },
  { file: 'typescript-icon', label: 'TypeScript', slug: 'typescript' },
  { file: 'nodejs-icon', label: 'Node.js', slug: 'nodejs' },
  { file: 'lovable-icon', label: 'Lovable', slug: 'lovable' },
  { file: 'perplexity-icon', label: 'Perplexity', slug: 'perplexity' },
  { file: 'python', label: 'Python' },
  { file: 'docker-icon', label: 'Docker', slug: 'docker' },
  { file: 'visual-studio-code', label: 'VS Code' },
  { file: 'javascript', label: 'JavaScript' },
  { file: 'claude-code', label: 'Claude Code' },
  { file: 'chrome', label: 'Chrome' },
];

const allIcons = await getCollection('icons');
const flagsBySlug = new Map(
  allIcons.map(i => [
    i.id,
    {
      badInDark: i.data.badInDark === true,
      badInLight: i.data.badInLight === true,
    },
  ]),
);

const ICONS: MarqueeIcon[] = SEED.map(s => {
  const flags = flagsBySlug.get(s.slug ?? s.file) ?? {
    badInDark: false,
    badInLight: false,
  };
  return { ...s, ...flags };
});

// Duplicate the row so the translate-50% loop is seamless.
const TRACK = [...ICONS, ...ICONS];
---

<section class="marquee" aria-label="Popular icons included in the package">
  <div class="marquee__rule" aria-hidden="true">
    <span class="marquee__tag">// FLAGSHIPS</span>
    <span class="marquee__count"
      >{ICONS.length.toString().padStart(2, '0')}</span
    >
  </div>
  <div class="marquee__frame">
    <div class="marquee__track" data-marquee-track>
      {
        TRACK.map((icon, i) => (
          <a
            href={`/icons/${icon.slug ?? icon.file}/`}
            data-astro-prefetch
            class="marquee__tile"
            aria-hidden={i >= ICONS.length ? 'true' : undefined}
            tabindex={i >= ICONS.length ? -1 : undefined}>
            <span class="marquee__index">
              {String((i % ICONS.length) + 1).padStart(2, '0')}
            </span>
            <IconRender
              iconFile={icon.file}
              name={icon.label}
              size={56}
              badInDark={icon.badInDark}
              badInLight={icon.badInLight}
              className="marquee__icon"
              imgClassName="w-full h-full object-contain"
            />
            <span class="marquee__label">{icon.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    position: relative;
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
    overflow: hidden;
    isolation: isolate;
  }

  .marquee__rule {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    line-height: 1;
  }

  .marquee__tag {
    color: var(--c-accent);
  }

  .marquee__frame {
    position: relative;
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .marquee__frame::before,
  .marquee__frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee__frame::before {
    left: 0;
    background: linear-gradient(90deg, var(--c-bg), transparent);
  }

  .marquee__frame::after {
    right: 0;
    background: linear-gradient(270deg, var(--c-bg), transparent);
  }

  .marquee__track {
    display: flex;
    flex: 0 0 auto;
    width: max-content;
    animation: scroll-infinite 60s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__tile {
    flex: 0 0 auto;
    width: 160px;
    height: 140px;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 14px;
    border-right: 1px solid var(--c-border);
    background: var(--c-bg);
    color: var(--c-text);
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .marquee__index {
    justify-self: start;
    align-self: start;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-text);
  }

  .marquee__icon {
    width: 56px;
    height: 56px;
    object-fit: contain;
    display: block;
    justify-self: center;
    align-self: center;
  }

  .marquee__label {
    justify-self: start;
    align-self: end;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--c-text);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .marquee__tile {
      width: 220px;
      height: 180px;
      padding: 18px;
    }
    .marquee__icon {
      width: 72px;
      height: 72px;
    }
    .marquee__index {
      font-size: 28px;
    }
    .marquee__label {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
