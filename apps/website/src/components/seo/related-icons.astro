---
import type { RelatedIcon } from "../../lib/related-icons";
import IconRender from "../icons/icon-render.astro";

interface Props {
  icons: RelatedIcon[];
  heading?: string;
}

const { icons, heading = "Related icons" } = Astro.props;

if (icons.length === 0) return;
---

<section class="mt-12 sm:mt-16 pt-6 sm:pt-8 border-t border-border">
  <h2 class="type-label mb-4 flex items-center gap-3">
    <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"></span>
    {heading}
  </h2>
  <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
    {icons.map((icon) => (
      <li>
        <a
          href={`/icons/${icon.slug}/`}
          data-astro-prefetch
          class="flex items-center gap-3 p-3 border border-border hover:border-accent/60 transition-colors group"
        >
          <IconRender
            iconFile={icon.iconFile}
            name={icon.name}
            size={32}
            badInDark={icon.badInDark}
            badInLight={icon.badInLight}
            className="w-8 h-8 shrink-0"
          />
          <span class="type-mono text-xs uppercase tracking-wider truncate group-hover:text-accent transition-colors">
            {icon.name}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
