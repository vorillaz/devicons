---
/*
  Brutalist AI-summary strip that mirrors the home-page // FLAGSHIPS marquee:
  hard-edged slab, mono rule header ("// EXPLORE AI SUMMARY" + count), and a
  row of tiles separated by 1px dividers. Each tile opens the provider with
  a page-aware summarization prompt pre-loaded.
*/
import { getEntry } from 'astro:content';
import { SITE_URL } from '../../consts';

interface Props {
  url?: string;
  brand?: string;
}

const { url, brand } = Astro.props;

const site = Astro.site ?? SITE_URL;
const pathname = Astro.url.pathname;
const pageUrl = url ?? new URL(pathname, site).toString();

// Point the assistant at the page's Markdown twin when one exists — it is
// smaller and cleaner to summarize than the rendered HTML.
const mdTwinPath = async (path: string): Promise<string | null> => {
  const p = path.endsWith('/') ? path : `${path}/`;
  if (p === '/') return '/index.md';
  const exact: Record<string, string> = {
    '/docs/': '/docs.md',
    '/icons/': '/icons.md',
    '/packs/': '/packs.md',
    '/compare/': '/compare.md',
    '/legal/': '/legal.md',
    '/search/': '/search.md',
  };
  if (exact[p]) return exact[p];
  const m = p.match(/^\/(docs|icons|packs|compare)\/([^/]+)\/$/);
  if (!m) return null;
  const [, section, slug] = m;
  if (section === 'icons') {
    // Only active icons get a Markdown twin.
    const icon = await getEntry('icons', slug);
    if (!icon || icon.data.deprecated) return null;
  }
  return `/${section}/${slug}.md`;
};

const twin = url ? null : await mdTwinPath(pathname);
const summaryUrl = twin ? new URL(twin, site).toString() : pageUrl;

const prompt = brand
  ? `Summarize this page about the ${brand} logo from Devicons: ${summaryUrl}`
  : `Summarize this page from Devicons: ${summaryUrl}`;

const encoded = encodeURIComponent(prompt);

const PROVIDERS: {
  id: string;
  name: string;
  iconFile: string;
  href: string;
  monochrome?: boolean;
}[] = [
  {
    id: 'openai',
    name: 'ChatGPT',
    iconFile: 'openai-icon',
    href: `https://chatgpt.com/?q=${encoded}`,
    monochrome: true,
  },
  {
    id: 'claude',
    name: 'Claude',
    iconFile: 'claude-icon',
    href: `https://claude.ai/new?q=${encoded}`,
  },
  {
    id: 'gemini',
    name: 'Gemini',
    iconFile: 'google-gemini-icon',
    href: `https://www.google.com/search?udm=50&aep=11&q=${encoded}`,
  },
  {
    id: 'perplexity',
    name: 'Perplexity',
    iconFile: 'perplexity-icon',
    href: `https://www.perplexity.ai/search/new?q=${encoded}`,
  },
  {
    id: 'grok',
    name: 'Grok',
    iconFile: 'grok-icon',
    href: `https://x.com/i/grok?text=${encoded}`,
    monochrome: true,
  },
];
---

<section class="ai-summary" aria-labelledby="ai-summary-tag">
  <div class="ai-summary__rule">
    <span id="ai-summary-tag" class="ai-summary__tag">
      // EXPLORE AI SUMMARY
    </span>
    <span class="ai-summary__count" aria-hidden="true">
      {PROVIDERS.length.toString().padStart(2, '0')}
    </span>
  </div>
  <ul class="ai-summary__row">
    {
      PROVIDERS.map((p, i) => (
        <li class="ai-summary__tile">
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${p.name} AI Summary`}
            class="ai-summary__link">
            <span class="ai-summary__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <img
              src={`/devicons/icons/${p.iconFile}.svg`}
              alt=""
              width="18"
              height="18"
              loading="lazy"
              decoding="async"
              class:list={[
                'ai-summary__icon',
                p.monochrome && 'ai-provider-mono',
              ]}
            />
            <span class="ai-summary__label">{p.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .ai-summary {
    position: relative;
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
    isolation: isolate;
  }

  .ai-summary__rule {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    line-height: 1;
  }

  .ai-summary__tag {
    color: var(--c-accent);
  }

  .ai-summary__row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-summary__tile {
    border-right: 1px solid var(--c-border);
  }

  .ai-summary__tile:last-child {
    border-right: 0;
  }

  .ai-summary__link {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    background: var(--c-bg);
    color: var(--c-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .ai-summary__link:hover,
  .ai-summary__link:focus-visible {
    color: var(--c-accent);
    outline: none;
  }

  .ai-summary__index {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1;
    color: var(--c-text-muted);
  }

  .ai-summary__icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .ai-summary__label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    color: inherit;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Mono provider logos (OpenAI, Grok) ship as pure-black SVGs. Invert to
     white on the dark theme so they remain legible; leave untouched on
     light, where black-on-white already reads cleanly. */
  .ai-provider-mono {
    filter: invert(1);
  }
  [data-theme='light'] .ai-provider-mono {
    filter: none;
  }

  @media (max-width: 640px) {
    .ai-summary__row {
      grid-template-columns: repeat(2, 1fr);
    }
    .ai-summary__tile:nth-child(2n) {
      border-right: 0;
    }
    .ai-summary__tile:not(:nth-last-child(-n + 2)) {
      border-bottom: 1px solid var(--c-border);
    }
    .ai-summary__tile:last-child {
      grid-column: span 2;
    }
  }
</style>
