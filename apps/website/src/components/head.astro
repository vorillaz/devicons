---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  SITE_TITLE,
  SITE_URL,
  SITE_AUTHOR,
  TWITTER_HANDLE,
  THEME_COLOR_LIGHT,
  THEME_COLOR_DARK,
} from "../consts";
import { organizationSchema, webPageSchema, websiteSchema } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Absolute or root-relative URL when the canonical differs from this page. */
  canonical?: string;
  /** Alt text for the social image; defaults to the page title. */
  imageAlt?: string;
  keywords?: string[];
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  ogType = "website",
  noindex = false,
  canonical,
  imageAlt,
  keywords,
  publishedTime,
  modifiedTime,
  author = SITE_AUTHOR,
  jsonLd,
} = Astro.props;

// Normalize canonical: lowercase + ensure trailing slash. This matches the
// site's trailingSlash: 'always' config so canonicals align with served URLs
// and the sitemap (no dual-URL split).
const rawPath = Astro.url.pathname.toLowerCase();
const normalizedPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonicalURL = new URL(canonical ?? normalizedPath, Astro.site ?? SITE_URL);

// Markdown alternate: emit <link rel="alternate" type="text/markdown"> for
// pages that have a pre-rendered .md counterpart so agents can discover them
// without content negotiation.
function resolveMarkdownAlternate(path: string): string | null {
  if (path === "" || path === "/") return "/index.md";
  const trimmed = path.replace(/\/$/, "");
  // Known top-level pages with MD counterparts.
  if (trimmed === "/search" || trimmed === "/legal") return `${trimmed}.md`;
  if (
    trimmed === "/docs" ||
    trimmed === "/icons" ||
    trimmed === "/packs" ||
    trimmed === "/compare"
  )
    return `${trimmed}.md`;
  // Listing/utility pages under /icons do not have MD counterparts, and
  // neither do icon sub-pages (/icons/<slug>/<framework|variants>/): only
  // /icons/<slug>.md is generated.
  if (
    trimmed.startsWith("/icons/tag/") ||
    trimmed.startsWith("/icons/color/") ||
    trimmed === "/icons/popular" ||
    /^\/icons\/[^/]+\/.+/.test(trimmed)
  )
    return null;
  // Prerendered content pages.
  if (
    trimmed.startsWith("/docs/") ||
    trimmed.startsWith("/icons/") ||
    trimmed.startsWith("/packs/") ||
    trimmed.startsWith("/compare/")
  )
    return `${trimmed}.md`;
  return null;
}

// Noindexed pages (deprecated icons, thin tags, secondary framework pages)
// advertise neither a Markdown twin nor a canonical.
const markdownAlternatePath = noindex ? null : resolveMarkdownAlternate(normalizedPath);
const markdownAlternate = markdownAlternatePath
  ? new URL(markdownAlternatePath, Astro.site ?? SITE_URL).toString()
  : null;

const ogImage = image ? new URL(image, Astro.site ?? SITE_URL).toString() : undefined;
const siteOrigin = (Astro.site ?? new URL(SITE_URL)).toString().replace(/\/$/, "");
const pageJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
// One @graph instead of separate <script> blocks so `@id` references
// (publisher, creator, isPartOf → #organization / #website) resolve within a
// single document for every consumer, not just Google.
const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema(siteOrigin),
    websiteSchema(siteOrigin),
    ...(noindex
      ? []
      : [
          webPageSchema({
            url: canonicalURL.toString(),
            name: title,
            description,
            image: ogImage,
            site: siteOrigin,
          }),
        ]),
    ...pageJsonLd,
  ].map(
    ({ "@context": _context, ...node }) => node,
  ),
};

const verificationGoogle = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!-- Theme persistence (must run before paint) -->
<script is:inline>
  (function() {
    var t = localStorage.getItem("theme");
    if (t === "light") document.documentElement.setAttribute("data-theme", "light");
  })();
</script>

<!-- Preserve theme across view transitions -->
<script is:inline>
  document.addEventListener("astro:before-swap", function(e) {
    var t = localStorage.getItem("theme");
    if (t === "light") e.newDocument.documentElement.setAttribute("data-theme", "light");
  });
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content={THEME_COLOR_LIGHT} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME_COLOR_DARK} media="(prefers-color-scheme: dark)" />

<!-- Fonts via Astro font system (preloaded, locally cached) -->
<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-mono" preload={[{ weight: 600 }]} />

<!-- View transitions for smooth page navigation -->
<ClientRouter fallback="swap" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site ?? SITE_URL)}
/>
{markdownAlternate && (
  <link
    rel="alternate"
    type="text/markdown"
    title={`${title} (Markdown)`}
    href={markdownAlternate}
  />
)}
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
{!noindex && <link rel="canonical" href={canonicalURL} />}

<!-- Robots -->
<meta
  name="robots"
  content={noindex
    ? "noindex, follow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{keywords && keywords.length > 0 && (
  <meta name="keywords" content={keywords.join(", ")} />
)}
{verificationGoogle && (
  <meta name="google-site-verification" content={verificationGoogle} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={imageAlt ?? title} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:type" content="image/png" />}
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{ogType === "article" && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{ogType === "article" && author && (
  <meta property="article:author" content={author} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={title} />}

<!-- Structured data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
