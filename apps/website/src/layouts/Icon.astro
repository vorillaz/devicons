---
import type { CollectionEntry } from 'astro:content';
import PageLayout from '../components/layout/page-layout.astro';
import { IconDetail } from '../components/icons/icon-detail';
import Breadcrumbs from '../components/seo/breadcrumbs.astro';
import RelatedIcons from '../components/seo/related-icons.astro';
import { Badge } from '../components/ui/badge';
import { Tag } from '../components/ui/tag';
import {
  breadcrumbSchema,
  iconBrandSchema,
  iconImageSchema,
} from '../lib/seo';
import { getRelatedIcons } from '../lib/related-icons';
import { getActiveIcons, getUniqueTags, slugifyTag } from '../lib/icons-query';
import { fitDescription, fitTitle } from '../lib/meta';
import { bucketForHex } from '../lib/colors';
import { COMPARISONS, compareSlug } from '../data/comparisons';

type IconNav = { slug: string; name: string } | null;
type Props = CollectionEntry<'icons'>['data'] & {
  slug: string;
  prev: IconNav;
  next: IconNav;
};

const {
  name,
  description,
  aliases,
  icons,
  tags,
  deprecated,
  version,
  website,
  license,
  brandGuidelines,
  mainColor,
  otherColors,
  badInDark,
  badInLight,
  slug,
  prev,
  next,
} = Astro.props;

const contrastHint = badInDark && badInLight
  ? 'Low contrast — preview on a patterned background'
  : badInDark
    ? 'Looks better on a light background'
    : badInLight
      ? 'Looks better on a dark background'
      : null;

const title = fitTitle(
  `${name} Logo SVG — Free React, Vue & Svelte Icon | Devicons`,
  `${name} Logo — Free SVG & React Icon | Devicons`,
  `${name} Logo — Free SVG Icon | Devicons`,
  `${name} Logo SVG | Devicons`,
  `${name} Logo SVG`,
);
const metaDescription = fitDescription(
  description,
  `Download the ${name} logo as a free SVG or use the React, Vue, and Svelte components.`,
  `Free ${name} logo SVG plus React, Vue & Svelte components.`,
  `Free ${name} logo SVG download.`,
  `Free SVG download.`,
) || `Download the ${name} logo as an optimized SVG. Free React, Vue, and Svelte components under the MIT license.`;

// Only link to pages that are actually generated: tag, variants and compare
// pages are built from non-deprecated icons only.
const activeIcons = await getActiveIcons();
const activeIds = new Set(activeIcons.map(i => i.id));
const tagsWithPages = new Set((await getUniqueTags()).map(t => t.tag));
const hasVariantsPage = !deprecated && icons.length > 1;
const altNames = (aliases ?? []).filter(
  (a: string) => a.toLowerCase() !== name.toLowerCase(),
);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Icons', url: '/icons' },
    { name, url: `/icons/${slug}` },
  ]),
  iconBrandSchema({ name, description, slug, website, mainColor }),
  iconImageSchema({ name, slug, license, brandGuidelines }),
];

const colorChips = [
  mainColor ? { hex: mainColor, label: 'Primary' } : null,
  ...(otherColors ?? []).map((hex: string) => ({ hex, label: 'Secondary' })),
].filter((c): c is { hex: string; label: string } => c !== null);

const comparisonPairs = COMPARISONS.filter(
  cmp => activeIds.has(cmp.a) && activeIds.has(cmp.b),
).flatMap(cmp => {
  if (cmp.a === slug) return [{ otherSlug: cmp.b, pairSlug: compareSlug(cmp.a, cmp.b) }];
  if (cmp.b === slug) return [{ otherSlug: cmp.a, pairSlug: compareSlug(cmp.a, cmp.b) }];
  return [];
});

const comparisonPartners = comparisonPairs.length
  ? (() => {
      const byId = new Map(activeIcons.map(i => [i.id, i.data.name]));
      return comparisonPairs.map(c => ({
        ...c,
        otherName: byId.get(c.otherSlug) ?? c.otherSlug,
      }));
    })()
  : [];

const related = await getRelatedIcons(slug, tags, 8);
---

<PageLayout
  title={title}
  description={metaDescription}
  image={`/og/icons/${slug}.png`}
  jsonLd={jsonLd}
  brand={name}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Icons', url: '/icons' },
        { name },
      ]}
    />

    <!-- impeccable-carbonize-start ef0e829b -->
    <style data-impeccable-css="ef0e829b">
    [data-impeccable-variant] > header.ih { margin-top: 1.5rem; margin-bottom: 2rem; }
    [data-impeccable-variant] > header.ih .ih-mono {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500;
    letter-spacing: var(--tracking-caps); text-transform: uppercase; line-height: 1; color: var(--c-text-muted);
    }
    [data-impeccable-variant] > header.ih .ih-link {
    display: inline-flex; align-items: center; gap: 0.375rem;
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    letter-spacing: var(--tracking-caps); text-transform: uppercase; line-height: 1;
    color: var(--c-text-secondary); transition: color .15s ease, border-color .15s ease;
    }
    [data-impeccable-variant] > header.ih .ih-link:hover { color: var(--c-text); }
    [data-impeccable-variant] > header.ih .ih-chip {
    display: inline-flex; align-items: center; gap: 0.375rem;
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    letter-spacing: var(--tracking-caps); text-transform: uppercase; line-height: 1;
    color: var(--c-text-muted); transition: color .15s ease;
    }
    [data-impeccable-variant] > header.ih a.ih-chip:hover { color: var(--c-text); }
    [data-impeccable-variant] > header.ih .ih-tag { padding: 0.375rem 0.625rem; }
    
    /* V1 — Hierarchy */
    [data-impeccable-variant="1"] > header.ih .ih1-meta { margin-top: 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
    [data-impeccable-variant="1"] > header.ih .ih1-dep { color: var(--c-destructive); }
    [data-impeccable-variant="1"] > header.ih .ih1-sep { color: var(--c-border); }
    [data-impeccable-variant="1"] > header.ih .ih1-variants { color: var(--c-accent); }
    [data-impeccable-variant="1"] > header.ih .ih1-variants:hover { color: var(--c-accent-hover); }
    [data-impeccable-variant="1"] > header.ih .ih1-desc { margin-top: 1.25rem; max-width: 64ch; }
    [data-impeccable-variant="1"] > header.ih .ih1-aka { margin-top: 0.5rem; }
    [data-impeccable-variant="1"] > header.ih .ih1-facts {
    margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    }
    [data-impeccable-variant="1"] > header.ih .ih1-facts .ih-link {
    padding: 0.5rem 0.75rem; border: 1px solid var(--c-border); background: var(--c-surface);
    }
    [data-impeccable-variant="1"] > header.ih .ih1-facts .ih-link:hover { border-color: var(--c-text-muted); }
    [data-impeccable-variant="1"] > header.ih .ih1-facts .ih-link:active { background: var(--c-text); color: var(--c-bg); }
    [data-impeccable-variant="1"] > header.ih .ih1-colors { display: inline-flex; flex-wrap: wrap; gap: 0.75rem; margin-left: 0.5rem; }
    [data-impeccable-variant="1"] > header.ih .ih1-tags { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
    [data-impeccable-variant="1"][data-p-hide-tags] > header.ih .ih1-tags { display: none; }
    
    /* V2 — Rhythm: ruled spec sheet */
    [data-impeccable-variant="2"] > header.ih { display: grid; gap: 2rem; }
    @media (min-width: 1024px) {
    [data-impeccable-variant="2"][data-p-layout="split"] > header.ih { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); gap: 3rem; align-items: start; }
    }
    [data-impeccable-variant="2"] > header.ih .ih2-desc { margin-top: 0.75rem; max-width: 64ch; }
    [data-impeccable-variant="2"] > header.ih .ih2-aka { margin-top: 0.5rem; }
    [data-impeccable-variant="2"] > header.ih .ih2-sheet { border-top: 1px solid var(--c-border); }
    [data-impeccable-variant="2"] > header.ih .ih2-row {
    display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; align-items: center;
    padding: 0.75rem 0; border-bottom: 1px solid var(--c-border);
    }
    [data-impeccable-variant="2"][data-p-compact] > header.ih .ih2-row { padding: 0.5rem 0; }
    [data-impeccable-variant="2"] > header.ih .ih2-row dd { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; min-width: 0; }
    [data-impeccable-variant="2"] > header.ih .ih2-value { color: var(--c-text); }
    [data-impeccable-variant="2"] > header.ih .ih2-dep { color: var(--c-destructive); }
    [data-impeccable-variant="2"] > header.ih .ih2-row a.ih2-value:hover { color: var(--c-accent); }
    
    /* V3 — Micro-details: incumbent layout, consistent details */
    [data-impeccable-variant="3"] > header.ih .ih3-desc { margin-top: 0.75rem; max-width: 64ch; }
    [data-impeccable-variant="3"] > header.ih .ih3-aka { margin-top: 0.5rem; }
    [data-impeccable-variant="3"] > header.ih .ih3-row { margin-top: 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
    [data-impeccable-variant="3"] > header.ih .ih3-group { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
    [data-impeccable-variant="3"] > header.ih .ih3-group + .ih3-group { padding-left: 1rem; border-left: 1px solid var(--c-border); }
    [data-impeccable-variant="3"][data-p-accent-links] > header.ih .ih-link { color: var(--c-accent); }
    [data-impeccable-variant="3"][data-p-accent-links] > header.ih .ih-link:hover { color: var(--c-accent-hover); }
    [data-impeccable-variant="3"] > header.ih .ih3-tags { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
    </style>
    <!-- impeccable-param-values ef0e829b: {"hide-tags":false} -->
    <!-- impeccable-carbonize-end ef0e829b -->
    <div data-impeccable-variant="1" style="display: contents">
      <header class="ih ih1">
        <h1 class="type-display-sm">{name}</h1>
        <p class="ih1-meta ih-mono">
          {hasVariantsPage ? (
            <a href={`/icons/${slug}/variants/`} data-astro-prefetch class="ih1-variants">
              {icons.length} {icons.length === 1 ? 'style' : 'styles'} →
            </a>
          ) : (
            <span>{icons.length} {icons.length === 1 ? 'style' : 'styles'}</span>
          )}
          {version && (<><span class="ih1-sep" aria-hidden="true">/</span><span>v{version}</span></>)}
          {deprecated && (<><span class="ih1-sep" aria-hidden="true">/</span><span class="ih1-dep">Deprecated</span></>)}
        </p>
        {description && <p class="type-body-lg ih1-desc">{description}</p>}
        {
          altNames.length > 0 && (
            <p class="type-body-sm text-text-muted ih1-aka">
              Also known as {altNames.join(', ')}
            </p>
          )
        }
        <div class="ih1-facts">
          {
            website && (
              <a href={website} target="_blank" rel="noopener noreferrer" class="ih-link">
                {website.replace(/^https?:\/\//, '').replace(/\/$/, '')} <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {
            license && (
              <a href={license} target="_blank" rel="noopener noreferrer" class="ih-link">
                License <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {
            brandGuidelines && (
              <a href={brandGuidelines} target="_blank" rel="noopener noreferrer" class="ih-link">
                Brand <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {colorChips.length > 0 && (
            <span class="ih1-colors">
              {
            colorChips.map(({ hex, label }) => {
              const bucket = bucketForHex(hex);
              const hexText = hex.toUpperCase();
              const swatch = (
                <span
                  aria-hidden="true"
                  class="inline-block w-3 h-3 border border-border shrink-0"
                  style={`background-color: ${hex}`}
                />
              );
              return bucket ? (
                <a href={`/icons/color/${bucket}/`} aria-label={`${label} brand color ${hexText}`} class="ih-chip">
                  {swatch}
                  {hexText}
                </a>
              ) : (
                <span aria-label={`${label} brand color ${hexText}`} class="ih-chip">
                  {swatch}
                  {hexText}
                </span>
              );
            })
          }
            </span>
          )}
        </div>
        {
          tags.length > 0 && (
            <div class="ih1-tags">
              {tags.map((tag: string) => (
                <Tag
                  className="ih-tag"
                  href={
                    tagsWithPages.has(tag)
                      ? `/icons/tag/${slugifyTag(tag)}/`
                      : undefined
                  }>
                  {tag.replace(/-/g, ' ')}
                </Tag>
              ))}
            </div>
          )
        }
      </header>
    </div>
  </div>

  {
    contrastHint && (
      <p class="max-w-4xl mx-auto px-4 sm:px-6 mb-3 font-mono text-[10px] font-semibold uppercase tracking-caps leading-none text-text-muted flex items-center gap-2">
        <span aria-hidden="true" class="inline-block w-2 h-2 bg-accent" />
        {contrastHint}
      </p>
    )
  }

  <IconDetail
    client:idle
    name={name}
    icons={icons}
    slug={slug}
    badInDark={badInDark}
    badInLight={badInLight}
  />

  {
    Astro.slots.has('default') && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 mt-12 sm:mt-16">
        <div class="border-t border-border pt-8 sm:pt-10">
          <div class="prose max-w-[70ch]">
            <slot />
          </div>
        </div>
      </section>
    )
  }

  {
    comparisonPartners.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 mt-12 sm:mt-16">
        <div class="border-t border-border pt-6 sm:pt-8">
          <p class="type-label mb-3 flex items-center gap-3">
            <span
              aria-hidden="true"
              class="inline-block w-3 h-[2px] bg-accent"
            />
            Compare
          </p>
          <ul class="flex flex-wrap gap-2">
            {comparisonPartners.map(c => (
              <li>
                <a
                  href={`/compare/${c.pairSlug}/`}
                  data-astro-prefetch
                  class="inline-flex items-center gap-2 px-3 py-2 border border-border text-sm hover:border-accent hover:text-accent transition-colors">
                  <span class="font-mono text-xs uppercase tracking-caps text-text-muted">
                    vs
                  </span>
                  <span>{c.otherName}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="max-w-4xl mx-auto px-4 sm:px-6 mt-12 sm:mt-16 pb-8 sm:pb-12">
    <RelatedIcons icons={related} />

    {
      (prev || next) && (
        <nav
          aria-label="Icon navigation"
          class="mt-12 sm:mt-16 pt-6 sm:pt-8 border-t border-border grid grid-cols-2 gap-3 sm:gap-4">
          {prev ? (
            <a
              href={`/icons/${prev.slug}/`}
              data-astro-prefetch
              class="group flex flex-col gap-2 p-4 border border-border hover:border-accent/60 transition-colors">
              <span class="type-meta group-hover:text-accent transition-colors">
                Previous
              </span>
              <span class="type-h3 truncate">{prev.name}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={`/icons/${next.slug}/`}
              data-astro-prefetch
              class="group flex flex-col gap-2 p-4 border border-border hover:border-accent/60 transition-colors text-right sm:col-start-2">
              <span class="type-meta group-hover:text-accent transition-colors">
                Next
              </span>
              <span class="type-h3 truncate">{next.name}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </section>
</PageLayout>
